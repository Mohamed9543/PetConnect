# Copy this file to .env and fill in the values.

# Replace with your machine's LAN IP when testing on a physical device,
# e.g. http://192.168.1.10:5000/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Google Sign-In (see the Google Cloud Console setup steps you were given).
# The web client ID is enough for web + Expo Go testing; add the iOS/Android
# ones later once you build a standalone/dev client for native Google Sign-In.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
